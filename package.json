{
  "name": "powerbi-visuals-html-studio",
  "version": "0.1.1",
  "description": "Render HTML/SVG on the Power BI canvas with a templating engine, component library, interactive charts, Bootstrap 5 and a built-in Monaco editor.",
  "license": "MIT",
  "private": true,
  "author": "Selim Ozbas <selimozbas@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/selimozbas/PowerBI-HTML-Studio"
  },
  "scripts": {
    "embed-bootstrap": "node scripts/embed-bootstrap.mjs",
    "prepare": "node scripts/embed-bootstrap.mjs",
    "prestart": "node scripts/embed-bootstrap.mjs",
    "prepackage": "node scripts/embed-bootstrap.mjs",
    "start": "pbiviz start",
    "package": "pbiviz package",
    "postpackage": "node scripts/rename-pbiviz.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.strict.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "dompurify": "^3.1.7",
    "marked": "^18.0.12",
    "monaco-editor": "^0.52.2",
    "powerbi-visuals-api": "~5.11.0",
    "qrcode-generator": "^1.5.2",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.11",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "eslint-plugin-powerbi-visuals": "^1.1.1",
    "powerbi-visuals-tools": "^7.2.1",
    "powerbi-visuals-utils-formattingmodel": "^7.1.0",
    "powerbi-visuals-utils-onobjectutils": "^6.0.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
